          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(task_execution_total{status=\"success\"}[1m]))",
          "legendFormat": "Success Rate",
          "refId": "B"
        }
      ]
