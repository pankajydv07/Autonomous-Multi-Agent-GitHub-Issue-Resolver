      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "rate(task_processing_duration_seconds_sum[1m]) / rate(task_processing_duration_seconds_count[1m])",
          "legendFormat": "Avg Processing Latency",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "rate(task_queue_wait_duration_seconds_sum[1m]) / rate(task_queue_wait_duration_seconds_count[1m])",
          "legendFormat": "Avg Queue Wait Latency",
          "refId": "B"
