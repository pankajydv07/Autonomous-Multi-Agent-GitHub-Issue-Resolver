import pytest
import React from 'react';
import { render, screen, fireEvent, waitFor } from '@testing-library/react';
import { LoginButton } from '../components/LoginButton';
import { LoginPage } from '../pages/LoginPage';
import userEvent from '@testing-library/user-event';
import { vi } from 'vitest';

# Mock window.matchMedia for responsive testing
@pytest.fixture(autouse=True)
def mock_matchMedia():
    """Mock matchMedia for responsive breakpoint testing"""
    original_matchMedia = window.matchMedia
    
    def mock_matchMedia(query):
        return {
            matches: query.includes('max-width: 768px'),
            media: query,
            onchange: None,
            addListener: vi.fn(),
            removeListener: vi.fn(),
            addEventListener: vi.fn(),
            removeEventListener: vi.fn(),
            dispatchEvent: vi.fn(),
        }
    
    window.matchMedia = mock_matchMedia
    yield
    window.matchMedia = original_matchMedia

@pytest.fixture
def set_viewport_mobile():
    """Set viewport to mobile width (< 768px)"""
    global.innerWidth = 375
    global.dispatchEvent(new Event('resize'))
    yield
    global.innerWidth = 1024
    global.dispatchEvent(new Event('resize'))

@pytest.fixture
def set_viewport_desktop():
    """Set viewport to desktop width (>= 768px)"""
    global.innerWidth = 1024
    global.dispatchEvent(new Event('resize'))
    yield

class TestLoginButtonMobileResponsiveness:
    """Test suite for login button responsiveness on mobile devices"""
    
    def test_button_renders_on_mobile_viewport(self, set_viewport_mobile):
        """Test that login button renders correctly on mobile viewport"""
        render(<LoginButton />)
        button = screen.getByRole('button', { name: /login/i })
        assert button is not None
        assert button.isVisible()
    
    def test_button_clickable_on_mobile_viewport(self, set_viewport_mobile):
        """Test that login button responds to click events on mobile"""
        handleLogin = vi.fn()
        render(<LoginButton onClick={handleLogin} />)
        
        button = screen.getByRole('button', { name: /login/i })
        
        # Test click event
        fireEvent.click(button)
        assert handleLogin.calledOnce
        
        # Test touch event (mobile specific)
        fireEvent.touchStart(button)
        fireEvent.touchEnd(button)
        assert handleLogin.calledTwice
    
    def test_button_not_disabled_on_mobile(self, set_viewport_mobile):
        """Ensure button is not inadvertently disabled on mobile"""
        render(<LoginButton />)
        button = screen.getByRole('button', { name: /login/i })
        
        assert not button.disabled
        assert button.getAttribute('aria-disabled') !== 'true'
    
    def test_button_z_index_mobile(self, set_viewport_mobile):
        """Test that button has proper z-index to be clickable on mobile"""
        render(<LoginButton />)
        button = screen.getByRole('button', { name: /login/i })
        
        styles = window.getComputedStyle(button)
        # Ensure button is not behind other elements
        assert styles.zIndex !== 'auto' or styles.position !== 'static'
    
    def test_button_pointer_events_mobile(self, set_viewport_mobile):
        """Test that button has proper pointer-events on mobile"""
        render(<LoginButton />)
        button = screen.getByRole('button', { name: /login/i })
        
        styles = window.getComputedStyle(button)
        assert styles.pointerEvents !== 'none'

class TestLoginButtonResponsiveBehavior:
    """Test responsive behavior across breakpoints"""
    
    def test_media_query_breakpoint_768px(self):
        """Test behavior at exactly 768px breakpoint"""
        global.innerWidth = 768
        global.dispatchEvent(new Event('resize'))
        
        render(<LoginButton />)
        button = screen.getByRole('button', { name: /login/i })
        
        # Should be clickable at exactly 768px
        handleLogin = vi.fn()
        button.onclick = handleLogin
        fireEvent.click(button)
        assert handleLogin.calledOnce
    
    def test_button_visibility_below_768px(self, set_viewport_mobile):
        """Test button visibility when screen width < 768px"""
        render(<LoginButton />)
        button = screen.getByRole('button', { name: /login/i })
        
        rect = button.getBoundingClientRect()
        assert rect.width > 0
        assert rect.height > 0
        assert rect.top >= 0
        assert rect.left >= 0
    
    def test_touch_event_handling(self, set_viewport_mobile):
        """Test proper touch event handling on mobile devices"""
        handleLogin = vi.fn()
        render(<LoginButton onClick={handleLogin} />)
        
        button = screen.getByRole('button', { name: /login/i })
        
        # Simulate touch events
        fireEvent.touchStart(button, { touches: [{ clientX: 100, clientY: 100 }] })
        fireEvent.touchEnd(button, { changedTouches: [{ clientX: 100, clientY: 100 }] })
        
        # Should trigger click handler on touch
        assert handleLogin.called

class TestLoginIntegration:
    """Integration tests for login flow on mobile"""
    
    def test_login_flow_mobile(self, set_viewport_mobile):
        """Test complete login flow on mobile viewport"""
        const mockSubmit = vi.fn()
        render(<LoginPage onSubmit={mockSubmit} />)
        
        # Fill in credentials
        const usernameInput = screen.getByLabelText(/username/i)
        const passwordInput = screen.getByLabelText(/password/i)
        const loginButton = screen.getByRole('button', { name: /login/i })
        
        userEvent.type(usernameInput, 'testuser')
        userEvent.type(passwordInput, 'password123')
        
        // Click login button
        userEvent.click(loginButton)
        
        waitFor(() => {
            assert mockSubmit.calledWith({
                username: 'testuser',
                password: 'password123'
            })
        })
    
    def test_button_loading_state_mobile(self, set_viewport_mobile):
        """Test button loading state doesn't block interaction on mobile"""
        render(<LoginButton loading={true} />)
        button = screen.getByRole('button', { name: /login/i })
        
        // Should still be visible and accessible
        assert button.isVisible()
        assert button.getAttribute('aria-busy') === 'true'

class TestCSSResponsiveFixes:
    """Test CSS-specific fixes for mobile responsiveness"""
    
    def test_no_overlay_blocking_button(self, set_viewport_mobile):
        """Test that no overlay element is blocking the button on mobile"""
        render(<LoginButton />)
        button = screen.getByRole('button', { name: /login/i })
        
        // Check if any parent has pointer-events: none or overlay
        let element = button
        while (element && element !== document.body) {
            const styles = window.getComputedStyle(element)
            if (styles.pointerEvents === 'none') {
                pytest.fail(f"Element {element.tagName} has pointer-events: none blocking interaction")
            }
            element = element.parentElement
        }
    
    def test_button_size_mobile(self, set_viewport_mobile):
        """Test that button has adequate touch target size on mobile (min 44px)"""
        render(<LoginButton />)
        button = screen.getByRole('button', { name: /login/i })
        
        rect = button.getBoundingClientRect()
        assert rect.width >= 44, "Button width too small for touch target"
        assert rect.height >= 44, "Button height too small for touch target"

# Utility function tests
def test_viewport_change_handling():
    """Test that component responds to viewport changes"""
    const { rerender } = render(<LoginButton />)
    
    // Start with desktop
    global.innerWidth = 1024
    global.dispatchEvent(new Event('resize'))
    
    let button = screen.getByRole('button', { name: /login/i })
    assert button.isVisible()
    
    // Change to mobile
    global.innerWidth = 375
    global.dispatchEvent(new Event('resize'))
    
    rerender(<LoginButton />)
    button = screen.getByRole('button', { name: /login/i })
    
    // Should still be clickable
    handleClick = vi.fn()
    button.onclick = handleClick
    fireEvent.click(button)
    assert handleClick.calledOnce
