class TestLoginButtonMobileResponsiveness:
    """Tests for login button functionality on mobile devices (< 768px)"""
    
    @pytest.fixture
    def mobile_viewport(self):
        """Fixture providing mobile viewport dimensions"""
        return {'width': 375, 'height': 667}  # iPhone SE size
    
    @pytest.fixture
    def tablet_viewport(self):
        """Fixture providing tablet viewport dimensions"""
        return {'width': 768, 'height': 1024}
    
    @pytest.fixture
    def desktop_viewport(self):
        """Fixture providing desktop viewport dimensions"""
        return {'width': 1920, 'height': 1080}

    @pytest.mark.asyncio
    async def test_login_button_clickable_mobile_viewport(self, mobile_viewport):
        """Test that login button responds to clicks on mobile viewport"""
        async with async_playwright() as p:
            browser = await p.chromium.launch()
            page = await browser.new_page(viewport=mobile_viewport)
            
            try:
                await page.goto('http://localhost:3000/login')
                
                # Wait for login button to be visible and enabled
                login_button = await page.wait_for_selector(
                    '[data-testid="login-button"], .login-btn, #login-button',
                    state='visible',
                    timeout=5000
                )
                
                # Verify button is enabled
                is_enabled = await login_button.is_enabled()
                assert is_enabled, "Login button should be enabled on mobile"
                
                # Verify button is not covered by other elements (clickable)
                box = await login_button.bounding_box()
                assert box is not None, "Login button should have bounding box"
                assert box['width'] > 0 and box['height'] > 0, "Login button should have visible dimensions"
                
                # Test click interaction
                await login_button.click()
                
                # Verify click was registered (e.g., form submission or navigation)
                # This depends on implementation - checking for loading state or navigation
                await page.wait_for_timeout(100)  # Small wait for event processing
                
            finally:
                await browser.close()

    @pytest.mark.asyncio
    async def test_login_button_touch_events_mobile(self, mobile_viewport):
        """Test that login button responds to touch events on mobile"""
        async with async_playwright() as p:
            browser = await p.chromium.launch()
            context = await browser.new_context(
                viewport=mobile_viewport,
                has_touch=True  # Enable touch events
            )
            page = await context.new_page()
            
            try:
                await page.goto('http://localhost:3000/login')
                
                login_button = await page.wait_for_selector(
                    '[data-testid="login-button"], .login-btn',
                    state='visible'
                )
                
                # Simulate touch event
                await login_button.tap()
                
                # Verify the button received the touch event
                # Check for any error messages or loading states
                error_message = await page.query_selector('.error-message, .login-error')
                if error_message:
                    error_text = await error_message.text_content()
                    assert "touch" not in error_text.lower(), f"Touch event error: {error_text}"
                
            finally:
                await browser.close()

    @pytest.mark.asyncio
    async def test_login_button_z_index_mobile(self, mobile_viewport):
        """Test that login button is not blocked by overlay elements on mobile"""
        async with async_playwright() as p:
            browser = await p.chromium.launch()
            page = await browser.new_page(viewport=mobile_viewport)
            
            try:
                await page.goto('http://localhost:3000/login')
                
                # Check for any overlay elements that might block the button
                overlays = await page.query_selector_all('.overlay, .modal-backdrop, .mobile-menu-overlay')
                
                login_button = await page.query_selector(
                    '[data-testid="login-button"], .login-btn, #login-button'
                )
                
                if login_button and overlays:
                    button_box = await login_button.bounding_box()
                    
                    for overlay in overlays:
                        overlay_box = await overlay.bounding_box()
                        if overlay_box and button_box:
                            # Check if overlay intersects with button
                            overlap = not (
                                overlay_box['x'] + overlay_box['width'] < button_box['x'] or
                                overlay_box['x'] > button_box['x'] + button_box['width'] or
                                overlay_box['y'] + overlay_box['height'] < button_box['y'] or
                                overlay_box['y'] > button_box['y'] + button_box['height']
                            )
                            
                            if overlap:
                                # Check if overlay has pointer-events: none
                                pointer_events = await overlay.evaluate('el => getComputedStyle(el).pointerEvents')
                                assert pointer_events == 'none', \
                                    f"Overlay blocking login button has pointer-events: {pointer_events}"
                
            finally:
                await browser.close()

    @pytest.mark.asyncio
    async def test_login_button_media_query_responsive(self):
        """Test that login button styles are correctly applied below 768px"""
        async with async_playwright() as p:
            browser = await p.chromium.launch()
            
            test_cases = [
                {'width': 767, 'height': 800, 'expected': 'mobile'},
                {'width': 768, 'height': 800, 'expected': 'tablet'},
                {'width': 375, 'height': 667, 'expected': 'mobile'},
                {'width': 320, 'height': 568, 'expected': 'mobile'},
            ]
            
            for case in test_cases:
                page = await browser.new_page(viewport={'width': case['width'], 'height': case['height']})
                
                try:
                    await page.goto('http://localhost:3000/login')
                    
                    login_button = await page.wait_for_selector(
                        '[data-testid="login-button"], .login-btn',
                        state='visible'
                    )
                    
                    # Check computed styles
                    styles = await login_button.evaluate('''el => {
                        const computed = getComputedStyle(el);
                        return {
                            display: computed.display,
                            visibility: computed.visibility,
                            pointerEvents: computed.pointerEvents,
                            position: computed.position
                        };
                    }''')
                    
                    # Button should be visible and interactive at all sizes
                    assert styles['display'] != 'none', f"Button hidden at width {case['width']}px"
                    assert styles['visibility'] == 'visible', f"Button not visible at width {case['width']}px"
                    assert styles['pointerEvents'] != 'none', f"Button not clickable at width {case['width']}px"
                    
                finally:
                    await page.close()
            
            await browser.close()

    def test_login_button_event_handlers_attached(self):
        """Unit test: Verify click event handlers are properly attached"""
        # Mock DOM environment
        mock_button = Mock()
        mock_button.addEventListener = Mock()
        mock_button.onclick = None
        
        # Simulate the fix: ensure event listeners are added
        def attach_login_handler(button):
            """Simulated function that should attach event listeners"""
            button.addEventListener('click', lambda e: e.preventDefault())
            button.addEventListener('touchstart', lambda e: e.preventDefault(), {'passive': True})
        
        attach_login_handler(mock_button)
        
        # Verify both click and touch events are handled
        calls = mock_button.addEventListener.call_args_list
        event_types = [call[0][0] for call in calls]
        
        assert 'click' in event_types, "Click event listener should be attached"
        # Touch events might be used for mobile responsiveness
        assert any('touch' in evt for evt in event_types), \
            "Touch event listener should be attached for mobile support"

    def test_viewport_detection_logic(self):
        """Unit test: Test viewport detection for mobile breakpoint"""
        def is_mobile_viewport(width):
            """Function to detect mobile viewport"""
            return width < 768
        
        # Test boundary conditions
        assert is_mobile_viewport(767) == True, "767px should be mobile"
        assert is_mobile_viewport(768) == False, "768px should not be mobile (tablet)"
        assert is_mobile_viewport(375) == True, "375px should be mobile"
        assert is_mobile_viewport(1024) == False, "1024px should not be mobile"

    @pytest.mark.asyncio
    async def test_login_button_accessibility_mobile(self, mobile_viewport):
        """Test accessibility attributes on mobile viewport"""
        async with async_playwright() as p:
            browser = await p.chromium.launch()
            page = await browser.new_page(viewport=mobile_viewport)
            
            try:
                await page.goto('http://localhost:3000/login')
                
                login_button = await page.wait_for_selector(
                    '[data-testid="login-button"], .login-btn, button[type="submit"]'
                )
                
                # Check accessibility attributes
                aria_label = await login_button.get_attribute('aria-label')
                role = await login_button.get_attribute('role') or await login_button.evaluate(
                    'el => el.tagName.toLowerCase() === "button" ? "button" : el.getAttribute("role")'
                )
                
                # Ensure button is accessible
                assert role in ['button', 'submit'], f"Button should have proper role, got: {role}"
                
                # Check if button is focusable
                is_focusable = await login_button.evaluate('''el => {
                    return !el.disabled && el.tabIndex >= 0 && getComputedStyle(el).display !== 'none';
                }''')
                
                assert is_focusable, "Login button should be focusable on mobile"
                
            finally:
                await browser.close()

    @pytest.mark.asyncio
    async def test_login_form_submission_mobile(self, mobile_viewport):
        """Integration test: Test full login flow on mobile"""
        async with async_playwright() as p:
            browser = await p.chromium.launch()
            page = await browser.new_page(viewport=mobile_viewport)
            
            try:
                await page.goto('http://localhost:3000/login')
                
                # Fill in login form
                await page.fill('input[name="username"], input[type="email"], #username', 'testuser')
                await page.fill('input[name="password"], input[type="password"], #password', 'testpass123')
                
                # Click login button
                await page.click('[data-testid="login-button"], .login-btn, button[type="submit"]')
                
                # Wait for navigation or API response
                try:
                    await page.wait_for_url('**/dashboard**', timeout=3000)
                    login_success = True
                except:
                    # Check for error message or loading state
                    error_selector = await page.query_selector('.error-message, .alert-danger')
                    loading_selector = await page.query_selector('.loading, .spinner')
                    
                    login_success = loading_selector is not None or error_selector is None
                
                assert login_success, "Login should proceed after button click on mobile"
                
            finally:
                await browser.close()


class TestCSSMediaQueries:
    """Tests for CSS media query behavior"""
    
    @pytest.mark.asyncio
    async def test_mobile_styles_applied_below_768px(self):
        """Verify that mobile-specific styles are applied below 768px"""
        async with async_playwright() as p:
            browser = await p.chromium.launch()
            
            # Test at 767px (should trigger mobile styles)
            page_mobile = await browser.new_page(viewport={'width': 767, 'height': 800})
            await page_mobile.goto('http://localhost:3000/login')
            
            login_button = await page_mobile.query_selector('.login-btn, [data-testid="login-button"]')
            if login_button:
                # Check if mobile-specific CSS class or style is applied
                class_list = await login_button.get_attribute('class')
                
                # Common mobile class patterns
                mobile_indicators = ['mobile', 'sm:', 'xs:', 'responsive']
                has_mobile_class = any(indicator in (class_list or '').lower() for indicator in mobile_indicators)
                
                # Or check computed styles for mobile-specific values
                font_size = await login_button.evaluate('el => getComputedStyle(el).fontSize')
                padding = await login_button.evaluate('el => getComputedStyle(el).padding')
                
                # Log for debugging
                print(f"Mobile viewport classes: {class_list}, font-size: {font_size}")
            
            await page_mobile.close()
            await browser.close()


