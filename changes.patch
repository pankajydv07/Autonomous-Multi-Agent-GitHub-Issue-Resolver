import pytest
from playwright.sync_api import Page, expect


class TestLoginButtonMobileResponsiveness:
    """Tests for login button functionality on mobile devices (< 768px)"""
    
    MOBILE_VIEWPORT = {'width': 375, 'height': 667}  # iPhone SE size
    TABLET_VIEWPORT = {'width': 1024, 'height': 768}  # Above threshold
    BREAKPOINT = 768
    
    @pytest.fixture
    def mobile_page(self, page: Page):
        """Setup mobile viewport"""
        page.set_viewport_size(self.MOBILE_VIEWPORT)
        yield page
    
    @pytest.fixture  
    def desktop_page(self, page: Page):
        """Setup desktop viewport"""
        page.set_viewport_size(self.TABLET_VIEWPORT)
        yield page
    
    def test_login_button_visible_on_mobile(self, mobile_page: Page):
        """Test that login button is visible at viewport < 768px"""
        mobile_page.goto("/login")
        login_button = mobile_page.locator("[data-testid='login-button'], #login-btn, .login-button").first
        
        expect(login_button).to_be_visible()
        # Check button is not hidden by CSS
        assert mobile_page.evaluate("(btn) => btn.offsetParent !== null", login_button.element_handle())
    
    def test_login_button_clickable_on_mobile(self, mobile_page: Page):
        """Test that login button responds to click events on mobile"""
        mobile_page.goto("/login")
        login_button = mobile_page.locator("[data-testid='login-button'], #login-btn, .login-button").first
        
        # Ensure button is enabled and clickable
        expect(login_button).to_be_enabled()
        
        # Attempt to click
        login_button.click()
        
        # Verify action was triggered (e.g., navigation or modal open)
        # Adjust based on actual implementation
        assert mobile_page.url != "/login" or mobile_page.locator(".login-modal, .auth-form").is_visible()
    
    def test_login_button_touch_events(self, mobile_page: Page):
        """Test touch event handling for mobile devices"""
        mobile_page.goto("/login")
        
        # Simulate touch events specifically
        mobile_page.evaluate("""
            () => {
                const btn = document.querySelector('[data-testid="login-button"], #login-btn, .login-button');
                const touchStartEvent = new TouchEvent('touchstart', { bubbles: true });
                const touchEndEvent = new TouchEvent('touchend', { bubbles: true });
                const clickEvent = new MouseEvent('click', { bubbles: true });
                
                btn.dispatchEvent(touchStartEvent);
                btn.dispatchEvent(touchEndEvent);
                btn.dispatchEvent(clickEvent);
                
                return btn !== null;
            }
        """)
        
        # Verify no JavaScript errors occurred
        logs = mobile_page.evaluate("() => { return window.errors || []; }")
        assert len(logs) == 0, f"JavaScript errors detected: {logs}"
    
    def test_no_z_index_overlay_blocking_mobile(self, mobile_page: Page):
        """Test that no overlay element blocks the login button on mobile"""
        mobile_page.goto("/login")
        
        # Check for elements with higher z-index that might overlay the button
        blocking_elements = mobile_page.evaluate("""
            () => {
                const btn = document.querySelector('[data-testid="login-button"], #login-btn, .login-button');
                if (!btn) return [];
                
                const rect = btn.getBoundingClientRect();
                const centerX = rect.left + rect.width / 2;
                const centerY = rect.top + rect.height / 2;
                
                // Get elements at the button's position
                const elements = document.elementsFromPoint(centerX, centerY);
                const btnIndex = elements.indexOf(btn);
                
                // Return elements that are above the button (lower index = higher z-index in elementsFromPoint)
                return elements.slice(0, btnIndex).map(el => el.className || el.id || el.tagName);
            }
        """)
        
        # Should only contain the button itself or legitimate parents
        assert len(blocking_elements) == 0, f"Blocking elements found: {blocking_elements}"
    
    def test_media_query_applies_correctly(self, mobile_page: Page, desktop_page: Page):
        """Test that CSS media queries apply correctly at 768px breakpoint"""
        mobile_page.goto("/login")
        desktop_page.goto("/login")
        
        # Check if mobile-specific styles are applied
        mobile_styles = mobile_page.evaluate("""
            () => {
                const btn = document.querySelector('[data-testid="login-button"], #login-btn, .login-button');
                if (!btn) return null;
                const styles = window.getComputedStyle(btn);
                return {
                    display: styles.display,
                    visibility: styles.visibility,
                    pointerEvents: styles.pointerEvents,
                    position: styles.position
                };
            }
        """)
        
        assert mobile_styles is not None, "Login button not found"
        assert mobile_styles['display'] != 'none', "Button hidden with display:none on mobile"
        assert mobile_styles['visibility'] != 'hidden', "Button hidden with visibility:hidden on mobile"
        assert mobile_styles['pointerEvents'] != 'none', "Button has pointer-events:none on mobile"
    
    def test_viewport_resize_handling(self, page: Page):
        """Test button functionality when resizing from desktop to mobile"""
        # Start at desktop size
        page.set_viewport_size(self.TABLET_VIEWPORT)
        page.goto("/login")
        
        # Verify button works at desktop
        login_button = page.locator("[data-testid='login-button'], #login-btn, .login-button").first
        expect(login_button).to_be_visible()
        
        # Resize to mobile
        page.set_viewport_size(self.MOBILE_VIEWPORT)
        page.wait_for_timeout(300)  # Allow for transition/resize events
        
        # Verify button still works
        expect(login_button).to_be_visible()
        expect(login_button).to_be_enabled()
        
        # Try to click after resize
        login_button.click()
        assert page.url != "/login" or page.locator(".login-modal").is_visible()
    
    def test_event_listeners_attached_mobile(self, mobile_page: Page):
        """Verify that click event listeners are properly attached on mobile"""
        mobile_page.goto("/login")
        
        has_listener = mobile_page.evaluate("""
            () => {
                const btn = document.querySelector('[data-testid="login-button"], #login-btn, .login-button');
                if (!btn) return false;
                
                // Check if onclick is set or event listeners are attached
                return btn.onclick !== null || 
                       btn.getAttribute('data-has-listener') === 'true' ||
                       typeof btn._events !== 'undefined';
            }
        """)
        
        assert has_listener, "No click event listener found on login button for mobile"


class TestLoginButtonCSS:
    """Unit-style tests for CSS and styling"""
    
    def test_button_not_disabled_via_css_mobile(self, mobile_page: Page):
        """Ensure button is not accidentally disabled via CSS at mobile widths"""
        mobile_page.goto("/login")
        
        # Check for common CSS issues
        issues = mobile_page.evaluate("""
            () => {
                const btn = document.querySelector('[data-testid="login-button"], #login-btn, .login-button');
                const issues = [];
                
                if (!btn) {
                    issues.push('Button not found in DOM');
                    return issues;
                }
                
                const rect = btn.getBoundingClientRect();
                const styles = window.getComputedStyle(btn);
                
                // Check size
                if (rect.width === 0 || rect.height === 0) {
                    issues.push('Button has zero dimensions');
                }
                
                // Check if covered by fixed/sticky header
                const viewportHeight = window.innerHeight;
                const viewportWidth = window.innerWidth;
                
                if (rect.top < 0 || rect.left < 0 || 
                    rect.bottom > viewportHeight || rect.right > viewportWidth) {
                    issues.push('Button positioned outside viewport');
                }
                
                // Check opacity
                if (parseFloat(styles.opacity) === 0) {
                    issues.push('Button has opacity: 0');
                }
                
                return issues;
            }
        """)
        
        assert len(issues) == 0, f"CSS issues found: {issues}"


